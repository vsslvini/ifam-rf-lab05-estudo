# ==========================================================
# Configuracoes de ambiente - Back-end IFAM
# Copie este arquivo para `.env` e ajuste os valores.
# ==========================================================

APP_NAME="Portal de Servicos e Gestao IFAM"
APP_VERSION="2.0.0"

# --- Banco de dados (PostgreSQL 15+) ---
# Suba o banco com `docker compose up -d postgres`. Este endereco e o usado
# pela API rodando no .venv; dentro do compose o host vira `postgres`.
DATABASE_URL="postgresql+psycopg://ifam:ifam@localhost:5432/ifam"

# `false`: PostgreSQL (schema e dados iniciais criados na subida da API).
# `true` : repositorio em memoria, sem banco - util para demonstrar sem Docker.
USE_IN_MEMORY_REPO=false

# --- Seguranca / JWT (RF-CORE01 - Equipe 1) ---
SECRET_KEY="troque-esta-chave-em-producao"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS (origens do app Expo em desenvolvimento) ---
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
